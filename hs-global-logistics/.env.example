# SMTP settings used by /api/contact.js to send the quote-request emails.
# For Gmail: use smtp.gmail.com, port 587, and a 16-character Google "App Password"
# (not your normal Gmail password) — generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password

# Address that receives new quote requests (defaults to sales@hsgloballogistic.com)
CONTACT_TO_EMAIL=sales@hsgloballogistic.com
